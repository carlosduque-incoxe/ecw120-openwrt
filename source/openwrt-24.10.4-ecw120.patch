--- a/target/linux/ipq40xx/image/generic.mk
+++ b/target/linux/ipq40xx/image/generic.mk
@@ -1326,3 +1326,16 @@
 endef
 # Missing DSA Setup
 #TARGET_DEVICES += zyxel_wre6606
+
+define Device/engenius_ecw120
+  $(call Device/FitImage)
+  DEVICE_VENDOR := EnGenius
+  DEVICE_MODEL := ECW120
