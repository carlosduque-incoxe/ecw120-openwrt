+func meshCredentials(cfg map[string]string) (string, string) {
+	ssid := cfg["mesh.essid"]
+	if ssid == "" {
+		// A vport is the local station name. The hidden downlink VAP
+		// can identify the site network if the mesh block omits its SSID.
+		for k, role := range cfg {
+			if !strings.HasPrefix(k, "wireless.") || !strings.HasSuffix(k, ".usage") || role != "downlink" {
+				continue
+			}
+			p := strings.TrimSuffix(k, "usage")
+			name := cfg[p+"ssid"]
+			if cfg[p+"vwire"] == "enabled" && cfg[p+"mode"] == "master" && strings.HasPrefix(name, "vwire-") && len(name) > 6 {
+				if ssid != "" && name != ssid {
+					return "", ""
+				}
+				ssid = name
+			}
+		}
+	}
+	if ssid == "" {
+		return "", ""
+	}
+	if key := cfg["mesh.psk"]; key != "" {
+		return ssid, key
+	}
+	var key string
+	for k, v := range cfg {
+		if strings.HasPrefix(k, "aaa.") && strings.HasSuffix(k, ".ssid") && v == ssid {
+			candidate := cfg[strings.TrimSuffix(k, "ssid")+"wpa.psk"]
+			if candidate == "" {
+				continue
+			}
+			if key != "" && candidate != key {
+				return ssid, ""
+			}
+			key = candidate
+		}
+	}
+	return ssid, key
+}
